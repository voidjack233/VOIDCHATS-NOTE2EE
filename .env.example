# Production reverse proxy (REST, account, messages, social, and conversations)
EXPO_PUBLIC_API_URL=https://api.void0000.online

# Gateway authenticated by the same HttpOnly cookie session as REST
EXPO_PUBLIC_GATEWAY_URL=wss://api.void0000.online/gateway

# Allow-listed web origin sent by React Native's native WebSocket client
EXPO_PUBLIC_GATEWAY_ORIGIN=https://void0000.online
