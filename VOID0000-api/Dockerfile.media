# syntax=docker/dockerfile:1.7
ARG GO_IMAGE=golang:1.26.6-alpine3.23@sha256:e57c41c1d5864341031181b0db34b9a537bb5773eb6428e4e5bdaea0f9135406
FROM ${GO_IMAGE} AS build
WORKDIR /build
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY media ./media
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -buildvcs=false -trimpath -ldflags='-s -w' -o /out/voidapp-media-worker ./media/entrypoint

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS runtime
ARG APP_VERSION=dev
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="VOID MP4 Media Worker" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}"
RUN apk add --no-cache ca-certificates ffmpeg util-linux \
    && test -x /usr/bin/ffmpeg && test -x /usr/bin/ffprobe && test -x /usr/bin/prlimit \
    && addgroup -g 10001 voidapp && adduser -D -H -u 10001 -G voidapp voidapp
WORKDIR /app
COPY --from=build /out/voidapp-media-worker /app/voidapp-media-worker
ENV NODE_ENV=production MEDIA_WORKER_HOST=0.0.0.0 MEDIA_WORKER_PORT=3007 GOMEMLIMIT=128MiB
USER 10001:10001
EXPOSE 3007
ENTRYPOINT ["/app/voidapp-media-worker"]
