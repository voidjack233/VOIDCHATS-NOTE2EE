# Generated by voidctl setup. Copying this file manually is supported, but
# placeholders must be replaced before the production stack can start.
VOID_COMPOSE_PROJECT=voidapp-prod
VOID_IMAGE_TAG=replace-with-git-sha
VOID_GIT_SHA=replace-with-full-git-sha
VOID_EDGE_BIND=127.0.0.1
VOID_EDGE_PORT=8080
VOID_DNS_RESOLVER=127.0.0.11

NODE_ENV=production
BIND_HOST=0.0.0.0
TRUST_PROXY=loopback,linklocal,uniquelocal
FRONT_URL=http://127.0.0.1:8080
CDN_URL=http://127.0.0.1:8080
VMD_PUBLIC_URL=http://127.0.0.1:8080
COOKIE_DOMAIN=

PGUSER=voidapp
PGHOST=postgres
PGDATABASE=voidapp
PGPASSWORD=replace-with-random-password
PGPORT=5432
PGSSLMODE=disable

SCYLLA_HOST=scylla
SCYLLA_KEYSPACE=voidapp
SCYLLA_LOCAL_DATACENTER=datacenter1
SCYLLA_REPLICATION_FACTOR=1

VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_DB=0

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=replace-with-random-access-key
MINIO_SECRET_KEY=replace-with-random-secret-key
MINIO_BUCKET=avatars
MINIO_GROUP_AVATAR_BUCKET=group-avatars
MINIO_ATTACH_BUCKET=chat-attachments
MINIO_VMD_CACHE_BUCKET=vmd-variants

ACCESS_SECRET=replace-with-random-secret
REFRESH_SECRET=replace-with-random-secret
CSRF_ENCRYPTION_KEY=replace-with-base64-key
TOTP_ENCRYPTION_KEY=replace-with-hex-key
TWO_FACTOR_CODE_SECRET=replace-with-random-secret
VMD_SIGNING_SECRET=replace-with-random-secret
PHX_SECRET_KEY_BASE=replace-with-random-secret

ATTACHMENT_SANITIZER_SOCKET_PATH=/run/voidapp/attachment-sanitizer.sock
VMD_TRANSFORM_SOCKET_PATH=/run/voidapp/vmd-transform.sock
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=4001

EMAIL_USER=
EMAIL_PASS=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
